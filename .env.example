APP_NAME=Herasat
APP_ENV=production
APP_KEY=
# Never enable debug in production (leaks stack traces and config)
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# XAMPP MySQL / MariaDB
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=herasat
DB_USERNAME=root
DB_PASSWORD=

# ---- Session / Sanctum SPA cookie auth ----
SESSION_DRIVER=database
SESSION_COOKIE=herasat_session
# idle timeout (minutes); absolute timeout is AUTH_ABSOLUTE_SESSION_MINUTES
SESSION_LIFETIME=60
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=strict
# set to true as soon as the site is served over HTTPS
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true

# Host(:port) of the Next.js site as seen by the browser (comma separated, no scheme)
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
# Origin(s) of the Next.js site (only used when the browser calls Laravel directly)
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Reverse proxies allowed to set X-Forwarded-For (Next.js runs on the same machine)
TRUSTED_PROXIES=127.0.0.1,::1
# Enable HSTS only when served over HTTPS
SECURITY_HSTS=false

# ---- Herasat security settings ----
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_CAPTCHA_AFTER_FAILURES=2
AUTH_ABSOLUTE_SESSION_MINUTES=480
PASSWORD_MIN_LENGTH=10
IMPORT_BCRYPT_ROUNDS=10
IMPORT_PERSONNEL_CODE_PAD=6

# Initial admin (seeder). The random password is written to this file, never printed.
ADMIN_USERNAME=admin
# ADMIN_CREDENTIALS_PATH=C:\xampp\htdocs\herasat\ADMIN_CREDENTIALS.txt

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log
